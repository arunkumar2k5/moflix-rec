TMDB_API_KEY=your_tmdb_api_key_here
# docker compose ignores this and keeps the database at /data/moflix.db on its named volume.
MOFLIX_DB=moflix.db
# Host port docker compose publishes the app on.
MOFLIX_PORT=8000

# OpenRouter — get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3-haiku
MOFLIX_MONTHLY_CAP=5.0
