TMDB_API_KEY=your_tmdb_api_key_here
# Ignored by docker compose, which keeps the database on its named volume at /data/moflix.db.
MOFLIX_DB=moflix.db
# Users with fewer watched movies than this get popular picks and an onboarding prompt.
MOFLIX_COLD_START_MIN=5

# OpenRouter — get your key at https://openrouter.ai/keys. Without one, chat runs in simple mode.
# The model slug picks the upstream provider too (anthropic/..., openai/..., google/...).
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3-haiku
MOFLIX_MONTHLY_CAP=5.0
# Chat messages each user may send per UTC day before POST /chat answers 429.
MOFLIX_CHAT_DAILY_CAP=50
